# ==============================================================================
# DATNIX SOLUTIONS - Server-Side Environment Variables
# IMPORTANT: Never commit actual secret keys to public source control.
# Set these variables in your hosting dashboard (Vercel, Netlify, or server .env).
# ==============================================================================

# 1. Primary Recommended Email Provider: Resend (https://resend.com)
# Create a free account at https://resend.com -> API Keys -> Create API Key
# Free Tier: 3,000 emails/month, 100/day. No credit card required.
RESEND_API_KEY=re_YOUR_ACTUAL_RESEND_API_KEY_HERE

# 2. Secondary Alternative Email Provider: SendGrid (https://sendgrid.com)
# If using SendGrid instead of Resend, provide your SendGrid API key here:
# SENDGRID_API_KEY=SG.YOUR_SENDGRID_API_KEY_HERE

# 3. Notification Destination Inbox
# The verified business email address where enquiry notifications will be sent:
NOTIFICATION_EMAIL=datnixsolutions@gmail.com

# 4. Verified Sender Address
# For testing: 'onboarding@resend.dev' works immediately with Resend.
# For production: after verifying your domain in Resend/SendGrid DNS, use:
# SENDER_EMAIL=enquiry@datnixsolutions.com
SENDER_EMAIL=onboarding@resend.dev
