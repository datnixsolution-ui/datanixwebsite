# ==============================================================================
# DATNIX SOLUTIONS - HARDENED PRODUCTION APACHE CONFIGURATION
# Tagline: DATA. PROCESS. PERFORMANCE.
# Headquarters: 20, Satkar Complex, Chimanlal Girdharlal Rd, Ahmedabad - 380006
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DIRECTORY BROWSING & ACCESS RESTRICTIONS
# ------------------------------------------------------------------------------
# Disable directory listing and multiview negotiation
Options -Indexes -MultiViews

# ------------------------------------------------------------------------------
# 2. GZIP / BROTLI COMPRESSION (mod_deflate / mod_filter)
# ------------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/xhtml+xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE application/ld+json
  AddOutputFilterByType DEFLATE application/manifest+json
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE image/x-icon
  AddOutputFilterByType DEFLATE font/ttf
  AddOutputFilterByType DEFLATE font/otf
  AddOutputFilterByType DEFLATE font/woff
  AddOutputFilterByType DEFLATE font/woff2
</IfModule>

# ------------------------------------------------------------------------------
# 3. BROWSER CACHE-CONTROL & EXPIRES HEADERS (mod_expires / mod_headers)
# ------------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # HTML & Manifest (Always fresh for updates)
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType application/manifest+json "access plus 1 week"

  # CSS & JavaScript (1 Year Immutable Caching)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"

  # Images & Media (1 Year Caching)
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # Web Fonts (1 Year Caching)
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/otf "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # 1-Year Immutable Caching for Static Assets
  <FilesMatch "\.(css|js|png|jpg|jpeg|gif|ico|svg|webp|woff|woff2|ttf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML & PHP Documents - Revalidate Immediately
  <FilesMatch "\.(html|htm|php)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # ----------------------------------------------------------------------------
  # ENTERPRISE SECURITY HEADERS
  # ----------------------------------------------------------------------------
  # Prevent MIME-type sniffing
  Header set X-Content-Type-Options "nosniff"

  # Prevent clickjacking / framing
  Header set X-Frame-Options "SAMEORIGIN"

  # XSS filter protection
  Header set X-XSS-Protection "1; mode=block"

  # Strict Referrer policy
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  # Restrict browser APIs and hardware access
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), screen-wake-lock=()"

  # HTTP Strict Transport Security (HSTS) - Enforce HTTPS for 1 year
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

  # Cross-Origin Policies (COOP & CORP)
  Header set Cross-Origin-Opener-Policy "same-origin"
  Header set Cross-Origin-Resource-Policy "same-origin"

  # Content Security Policy (CSP)
  Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://fonts.googleapis.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; connect-src 'self'; frame-ancestors 'self'; form-action 'self' https://wa.me; base-uri 'self'; object-src 'none';"
</IfModule>

# ------------------------------------------------------------------------------
# 4. DISABLE ETAGS (Reduces HTTP Header Overhead & 304 Validation Latency)
# ------------------------------------------------------------------------------
<IfModule mod_headers.c>
  Header unset ETag
</IfModule>
FileETag None

# ------------------------------------------------------------------------------
# 5. BLOCK DIRECT ACCESS TO SENSITIVE ARCHITECTURE FILES & DUMPS
# ------------------------------------------------------------------------------
<FilesMatch "(\.(env|sql|log|ini|sh|bak|git|md|app_key)|composer\.(json|lock)|package\.(json|lock)|database\.sql|\.app_key|\.htaccess|\.htpasswd)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>

# ------------------------------------------------------------------------------
# 6. URL SHIELD & EXPLOIT SCANNER FILTERING (mod_rewrite)
# ------------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Block dangerous HTTP verbs (prevent Cross-Site Tracing)
  RewriteCond %{REQUEST_METHOD} ^(TRACE|TRACK|DEBUG) [NC]
  RewriteRule .* - [F,L]

  # Block hidden files and directories (except .well-known for ACME SSL)
  RewriteRule (^|/)\.(?!well-known) - [F,L]

  # Block vulnerability probes and automated scanner paths
  RewriteCond %{REQUEST_URI} (wp-login\.php|wp-admin|xmlrpc\.php|phpmyadmin|pma|eval-stdin\.php|setup\.cgi|\.git|\.svn) [NC]
  RewriteRule .* - [F,L]
</IfModule>

# ------------------------------------------------------------------------------
# 7. UTF-8 DEFAULT ENCODING
# ------------------------------------------------------------------------------
AddDefaultCharset UTF-8
